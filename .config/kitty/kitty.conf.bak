font_family      JetBrainsMono Nerd Font
font_size        12

# --- TRANSPARENCY ---
# Background opacity (0.0 is invisible, 1.0 is solid)
# 0.8 is a good starting point for a nice see-through effect
background_opacity 0.7

# Optional: Dim inactive windows slightly more
dim_inactive 0.75

# Ensure the background color is set to allow transparency
# (Most themes do this automatically, but this ensures it)
dynamic_background_opacity yes

# When kitty is not focused, it gets darker/more transparent
inactive_text_alpha 0.7


# BEGIN_KITTY_THEME
# Tokyo Night Storm
include current-theme.conf
# END_KITTY_THEME
