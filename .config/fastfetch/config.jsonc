{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  
 "logo": {
    	"source": "~/.config/fastfetch/pngs/Bleach-PNG-High-Quality-Image.png",
    	"type": "kitty",
    	"height": 13,
    	"padding": {
    		"top": 3,
    		"left": 5
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
    "key": "│ {#34}󰃰 os age  {#keys}│",
    "type": "command",
    "text": "d=$(head -1 /var/log/pacman.log | grep -oP '\\d{4}-\\d{2}-\\d{2}'); y1=$(date -d $d +%Y); m1=$(date -d $d +%-m); d1=$(date -d $d +%-d); y2=$(date +%Y); m2=$(date +%-m); d2=$(date +%-d); y=$((y2-y1)); m=$((m2-m1)); dd=$((d2-d1)); if [ $dd -lt 0 ]; then m=$((m-1)); dd=$((dd+$(date -d \"$(date +%Y-%m-01) -1 day\" +%-d))); fi; if [ $m -lt 0 ]; then y=$((y-1)); m=$((m+12)); fi; echo \"$d (${y}y ${m}m ${dd}d)\""
},
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
     
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#31}󰏗 pkgs    {#keys}│",
            "type": "packages"
        },
        {
            "key": "│ {#36}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#33}󰇄 WM      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#31} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#33}󰥔 battery {#keys}│",
            "type": "battery"
        },
        {
            "key": "│ {#34}󰚥 power   {#keys}│",
            "type": "poweradapter"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
