configuration {
    modi:                "drun";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    matching:            "fuzzy";
    sort:                true;
    cycle:               true;
    drun-display-format: "{name}";
    drun-match-fields:   "name,generic,exec,categories,keywords";
    font:                "JetBrainsMono Nerd Font 11";
    hover-select:        true;
    me-select-entry:     "MouseSecondary";
    me-accept-entry:     "MousePrimary";
}

@theme "~/.cache/wal/colors-rofi-dark"

* {
    background-color: transparent;
    text-color:       @foreground;

    accent:     @selected-normal-background;
    muted:      rgba(242, 233, 244, 0.60);
    bg-window:  rgba(15, 15, 22, 0.38);
    bg-input:   rgba(255, 255, 255, 0.06);
    sel-bg:     rgba(255, 255, 255, 0.10);
}

window {
    transparency:     "real";
    location:         center;
    width:            750px;
    height:           420px;
    border:           0px;
    border-radius:    25px;
    background-color: @bg-window;
    padding:          20px;
    children:         [ mainbox ];
}

mainbox {
    orientation: horizontal;
    spacing:     20px;
    children:    [ img, listbox ];
}

/* Left: wallpaper card. Size comes from padding (280px wide), height fills the window */
img {
    expand:           false;
    padding:          0px 160px;
    border-radius:    14px;
    background-color: transparent;
    background-image: url("~/.current_wallpaper", height);
}

/* Right: search + list */
listbox {
    expand:   true;
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @bg-input;
    children:         [ textbox-prompt, entry ];
    spacing:          8px;
}

textbox-prompt {
    expand:         false;
    str:            "";
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    columns:      1;
    border:       0px;
    lines:        6;
    spacing:      4px;
    scrollbar:    false;
    cycle:        true;
    fixed-height: false;
}

element {
    padding:       10px 12px;
    spacing:       12px;
    border-radius: 12px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @sel-bg;
    text-color:       @foreground;
}

element-icon {
    size:           28px;
    vertical-align: 0.5;
    cursor:         inherit;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    cursor:         inherit;
    text-color:     inherit;
    background-color: transparent;
}
